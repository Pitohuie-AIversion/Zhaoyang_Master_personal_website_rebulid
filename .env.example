# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Key Encryption Configuration
KEY_ENCRYPTION_KEY=your-32-character-encryption-key-here

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Analytics
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# SEO
VITE_ALLOW_INLINE_JSONLD=true

# Server Configuration
# Set NODE_ENV in the runtime environment instead of .env; Vite uses it during builds.
PORT=3001
USE_LOCAL_PROXY=false

# CORS Configuration
# Comma-separated origins are supported.
CORS_ORIGIN=http://localhost:5173

# Security Configuration
ADMIN_TOKEN=replace-with-a-long-random-admin-token
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
UPLOAD_MAX_SIZE=5242880
ALLOWED_FILE_TYPES=pdf,jpg,png,jpeg
